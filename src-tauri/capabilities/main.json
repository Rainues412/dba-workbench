{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workbench",
  "description": "Local workbench data and window controls",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*"] },
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-dashboard-stats",
    "allow-dashboard-recent-tasks",
    "allow-dashboard-database-distribution",
    "allow-tasks-list",
    "allow-tasks-detail",
    "allow-tasks-create",
    "allow-tasks-update",
    "allow-tasks-delete",
    "allow-resources-list",
    "allow-resources-facets",
    "allow-resources-detail",
    "allow-resources-create",
    "allow-resources-update",
    "allow-resources-delete",
    "allow-customers-list",
    "allow-customers-detail",
    "allow-customers-create",
    "allow-customers-update",
    "allow-customers-delete",
    "allow-library-list",
    "allow-library-facets",
    "allow-library-detail",
    "allow-library-create",
    "allow-library-update",
    "allow-library-delete",
    "allow-script-recent-views",
    "allow-script-record-view",
    "allow-script-version",
    "allow-global-search",
    "allow-desktop-painted",
    "allow-account-status",
    "allow-vault-profile"
  ]
}
