# Python and test caches
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
test-results/

# Local runtime: virtual environment, logs, and temporary files
.runtime/
.venv/

# Frontend dependencies; source, lockfile, and production build are tracked
frontend/node_modules/
frontend/*.tsbuildinfo

# Business data and recovery keys must never be published
server/workspace.db
server/workspace.db-wal
server/workspace.db-shm
server/.workspace_secret
server/.vault_recovery_private.pem
server/.vault_recovery_public.pem
